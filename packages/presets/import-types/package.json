{
  "name": "@graphql-codegen/import-types-preset",
  "version": "4.0.1",
  "type": "module",
  "description": "GraphQL Code Generator preset for importing types to operation file",
  "repository": {
    "type": "git",
    "url": "https://github.com/dotansimha/graphql-code-generator-community.git",
    "directory": "packages/presets/import-types"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/typings/index.d.cts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typings": "dist/typings/index.d.ts",
  "scripts": {
    "lint": "eslint **/*.ts"
  },
  "peerDependencies": {
    "graphql": "^16.0.0 || ^17.0.0"
  },
  "dependencies": {
    "@graphql-codegen/add": "^8.0.0",
    "@graphql-codegen/plugin-helpers": "^8.0.0",
    "@graphql-codegen/visitor-plugin-common": "^8.0.0",
    "tslib": "^2.8.1"
  },
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "typescript": {
    "definition": "dist/typings/index.d.ts"
  }
}
