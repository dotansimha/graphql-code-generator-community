{
  "name": "@graphql-codegen/near-operation-file-preset",
  "version": "5.2.4",
  "type": "module",
  "description": "GraphQL Code Generator preset for generating operation code near the operation file",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dotansimha/graphql-code-generator-community.git",
    "directory": "packages/presets/near-operation-file"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/typings/index.d.cts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typings": "dist/typings/index.d.ts",
  "scripts": {
    "lint": "eslint **/*.ts"
  },
  "peerDependencies": {
    "graphql": "^16.0.0 || ^17.0.0"
  },
  "dependencies": {
    "@graphql-codegen/add": "^8.0.0",
    "@graphql-codegen/plugin-helpers": "^8.0.0",
    "@graphql-codegen/visitor-plugin-common": "^8.0.0",
    "@graphql-tools/utils": "^11.0.0",
    "parse-filepath": "^1.0.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "8.0.0",
    "@graphql-codegen/typescript": "7.0.1",
    "@graphql-codegen/typescript-operations": "7.0.1",
    "@types/parse-filepath": "1.0.2"
  },
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "typescript": {
    "definition": "dist/typings/index.d.ts"
  }
}
