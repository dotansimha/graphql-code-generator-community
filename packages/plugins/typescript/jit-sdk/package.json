{
  "name": "@graphql-codegen/typescript-jit-sdk",
  "version": "5.0.0",
  "type": "module",
  "description": "GraphQL Code Generator plugin for generating a ready-to-use SDK that uses GraphQL JIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dotansimha/graphql-code-generator-community.git",
    "directory": "packages/plugins/typescript/jit-sdk"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/typings/index.d.cts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typings": "dist/typings/index.d.ts",
  "scripts": {
    "lint": "eslint **/*.ts"
  },
  "peerDependencies": {
    "@graphql-tools/utils": "^13.0.0",
    "graphql": "^16.0.0 || ^17.0.0",
    "graphql-jit": "^0.7.5 || ^0.8.10 || ^0.9.1",
    "graphql-tag": "^2.0.0"
  },
  "dependencies": {
    "@graphql-codegen/plugin-helpers": "^8.0.0",
    "@graphql-codegen/visitor-plugin-common": "^8.0.0",
    "auto-bind": "~4.0.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@graphql-codegen/typescript": "7.0.1",
    "@graphql-codegen/typescript-operations": "7.0.1",
    "@graphql-tools/utils": "13.2.2",
    "graphql-jit": "^0.8.10"
  },
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "typescript": {
    "definition": "dist/typings/index.d.ts"
  }
}
