{
  "name": "@graphql-codegen/typescript-react-offix",
  "version": "4.0.1",
  "type": "module",
  "description": "GraphQL Code Generator plugin for generating useOffline mutations for offix use",
  "repository": {
    "type": "git",
    "url": "https://github.com/dotansimha/graphql-code-generator-community.git",
    "directory": "packages/plugins/typescript/react-apollo-offix"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/typings/index.d.cts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typings": "dist/typings/index.d.ts",
  "scripts": {
    "prepack": "bob prepack"
  },
  "peerDependencies": {
    "graphql": "^16.0.0 || ^17.0.0",
    "graphql-tag": "^2.0.0"
  },
  "dependencies": {
    "@graphql-codegen/plugin-helpers": "^8.0.0",
    "@graphql-codegen/visitor-plugin-common": "^8.0.0",
    "auto-bind": "~4.0.0",
    "change-case-all": "1.0.15"
  },
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "typescript": {
    "definition": "dist/typings/index.d.ts"
  }
}
