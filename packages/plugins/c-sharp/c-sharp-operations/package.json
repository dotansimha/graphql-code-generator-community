{
  "name": "@graphql-codegen/c-sharp-operations",
  "version": "5.0.0",
  "type": "module",
  "description": "GraphQL Code Generator plugin for generating CSharp code based on GraphQL operations",
  "repository": "git@github.com:dotansimha/graphql-code-generator-community.git",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/typings/index.d.cts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typings": "dist/typings/index.d.ts",
  "scripts": {
    "lint": "eslint **/*.ts"
  },
  "peerDependencies": {
    "graphql": "^16.0.0 || ^17.0.0",
    "graphql-tag": "2.12.6"
  },
  "dependencies": {
    "@graphql-codegen/c-sharp-common": "3.0.0",
    "@graphql-codegen/plugin-helpers": "^8.0.0",
    "@graphql-codegen/visitor-plugin-common": "^8.0.0",
    "auto-bind": "~4.0.0",
    "change-case-all": "1.0.15",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@graphql-codegen/testing": "6.0.0"
  },
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "sideEffects": false,
  "typescript": {
    "definition": "dist/typings/index.d.ts"
  }
}
