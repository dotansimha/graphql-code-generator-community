{
  "name": "@graphql-codegen/python-generic-sdk",
  "version": "0.0.1",
  "type": "module",
  "description": "GraphQL Code Generator plugin that emits a Python SDK (get_sdk(requester) with one method per operation), modeled on the community typescript-generic-sdk plugin.",
  "repository": "git@github.com:dotansimha/graphql-code-generator-community.git",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/typings/index.d.cts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typings": "dist/typings/index.d.ts",
  "scripts": {
    "lint": "eslint **/*.ts"
  },
  "peerDependencies": {
    "graphql": "^16.0.0 || ^17.0.0"
  },
  "dependencies": {
    "@graphql-codegen/plugin-helpers": "^8.0.0",
    "@graphql-codegen/python-common": "0.0.2",
    "@graphql-codegen/visitor-plugin-common": "^8.0.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@graphql-codegen/testing": "6.0.0"
  },
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "sideEffects": false,
  "typescript": {
    "definition": "dist/typings/index.d.ts"
  }
}
